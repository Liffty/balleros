{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "gdb",
            "request": "attach",
            "name": "Attach to QEMU (BallerOS)",
            "executable": "target/x86_64-unknown-none/release/balleros",
            "target": "localhost:1234",
            "remote": true,
            "cwd": "${workspaceRoot}",
            "gdbpath": "gdb",
            "autorun": [
                "add-symbol-file stage1.elf 0x7c00",
                "add-symbol-file stage2.elf 0x7e00",
                "break stage2_start"
            ]
        }
    ]
}